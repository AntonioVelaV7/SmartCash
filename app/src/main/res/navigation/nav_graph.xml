<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartcash.ui.login.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.smartcash.ui.dashboard.DashboardFragment"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_addIncomeFragment"
            app:destination="@id/addIncomeFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_incomeHistoryFragment"
            app:destination="@id/incomeHistoryFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_addExpenseFragment"
            app:destination="@id/addExpenseFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_expenseHistoryFragment"
            app:destination="@id/expenseHistoryFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addIncomeFragment"
        android:name="com.example.smartcash.ui.income.AddIncomeFragment"
        tools:layout="@layout/fragment_add_income">
        <action
            android:id="@+id/action_addIncomeFragment_to_incomeHistoryFragment"
            app:destination="@id/incomeHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/incomeHistoryFragment"
        android:name="com.example.smartcash.ui.income.IncomeHistoryFragment"
        tools:layout="@layout/fragment_income_history" />

    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.example.smartcash.ui.expense.AddExpenseFragment"
        tools:layout="@layout/fragment_add_expense">
        <action
            android:id="@+id/action_addExpenseFragment_to_expenseHistoryFragment"
            app:destination="@id/expenseHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/expenseHistoryFragment"
        android:name="com.example.smartcash.ui.expense.ExpenseHistoryFragment"
        tools:layout="@layout/fragment_expense_history">
        <action
            android:id="@+id/action_expenseHistoryFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.smartcash.ui.stats.StatisticsFragment"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.smartcash.ui.settings.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>

